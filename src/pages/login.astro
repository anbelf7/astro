---
import Login from "@/layouts/Login.astro";
import LoginForm, { ErrorForm } from "@/components/Login";

import pb from "@/lib/pocketbase";

let err = false;

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const username = data.get("username");
    const password = data.get("password");
    console.log(data);

    // if (!pb.authStore.isValid) {

    // login con i dati di amministratore
    const authData = await pb.admins.authWithPassword(username, password);

    // login con i dati creati dentro la collection users
    // const authData = await pb
    //   .collection("users")
    //   .authWithPassword(username, password);
    // console.log("authData:", authData);

    Astro.cookies.set("pbToken", pb.authStore.token, {
      path: "/",
      httpOnly: true,
      // Quando usata in produzione eliminare il commento:
      //secure: true,
    });
    // }

    // console.log(pb.authStore.isValid);
    // console.log(pb.authStore.token);

    return Astro.redirect("/");
  } catch (error) {
    if (error instanceof Error) {
      console.error(error.message);
      err = true
      // console.log(pb.authStore.isValid);
    }
  }
}
---

<Login>
  <main class="flex h-screen content-center justify-center">
    <form method="POST" class="content-center justify-center">
      {err ? <ErrorForm client:load /> : <LoginForm />}
    </form>
  </main>
</Login>

<script>
  // elementi dentro Login.jsx (shadcn/ui)
  const spinnerButton = document.getElementById("spinnerButton");
  const loginButton = document.getElementById("loginButton");
  const login = document.getElementById("login");
  // Aggiunge l'evento al submit del form
  document.addEventListener("submit", () => {
    spinnerButton.style.display = "flex";
    loginButton.style.display = "none";
    login.style.opacity = "0.5";
  });
</script>
